# PostgreSQL 16 connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custodysim
# E2E 默认复用上方服务器和凭据，仅将数据库名切换为此独立测试库。
E2E_DATABASE_NAME=custodysim_e2e
# 若测试库位于另一台服务器，也可显式配置完整地址，优先级高于数据库名。
E2E_DATABASE_URL=

# Generate a unique secret of at least 32 characters for each environment.
AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Required in production. Keep this separate from AUTH_SECRET and stable when
# rotating session-signing keys, otherwise existing MFA factors cannot decrypt.
MFA_ENCRYPTION_KEY=replace-this-with-a-separate-random-secret-of-at-least-32-characters

# Dedicated AES-256-GCM key for handwritten archive signatures. If omitted,
# AUTH_SECRET is used as a backward-compatible fallback.
ARCHIVE_SIGNATURE_ENCRYPTION_KEY=replace-this-with-a-separate-random-secret-of-at-least-32-characters

# Keep true (or leave unset) in any HTTPS production environment. Set false
# only for local HTTP access from a phone on the LAN.
AUTH_COOKIE_SECURE=true

# Required in production for CSRF origin validation, for example:
# APP_ORIGIN=https://custody.example.gov.cn
APP_ORIGIN=

# Set true only when the app is reachable exclusively through a reverse proxy
# that overwrites X-Real-IP (for example: proxy_set_header X-Real-IP $remote_addr).
TRUST_PROXY=false

# Demonstration accounts are disabled unless this is explicitly set to true in
# a non-production environment. Never enable this in production.
ALLOW_DEMO_SEED=false

# Provide these only to the one-time `pnpm db:bootstrap-admin` command, then
# remove INITIAL_ADMIN_PASSWORD from the environment immediately.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_ORGANIZATION_NAME=

# Optional: enables monthly local GeoLite2 City database updates for IP coarse location.
MAXMIND_LICENSE_KEY=
# Alternatively, keep the key in MaxMind's GeoIP.conf and provide its local path.
MAXMIND_GEOIP_CONF=

# Tencent Maps JavaScript API GL browser key. Restrict this key to your
# deployment domains in the Tencent Maps console; it is intentionally public.
NEXT_PUBLIC_TENCENT_MAP_KEY=
