# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/.logs/
# playwright 临时产物目录（由 --output 指定的本机路径产生）
/.pw-tmp-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local review artifacts
/.audit/
/artifacts/episteme-upstream/

# deployment backups
/.backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/artifacts/app-split-history/
/artifacts/prepare-app-repository.ps1

/artifacts/app-split-validation/
/.app-workspace/
/artifacts/android-migration-backup/
/artifacts/simplify-app.mjs
