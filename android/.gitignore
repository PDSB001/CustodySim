# Gradle
.gradle/
.kotlin/
build/
# 本机 Gradle 用户缓存目录（可达 GB 级）与 Miuix 构建临时目录，均不入库
.gradle-user-home/
.miuix-tmp/

# Gradle 自动生成的守护进程 JVM 约束：与本机 JDK 绑定，不该跟着版本库走
gradle/gradle-daemon-jvm.properties

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/

# 原生构建产物
.externalNativeBuild/
.cxx/
# release 产物会把编译期写入的 BASE_URL 一起打进去，不入库
app/release/

# 签名材料绝不入库
*.jks
*.keystore

# Private APKs must never enter the repository, including manually copied exports.
*.apk
*.aab
app/production/
app/development/
app/benchmark/
