<?xml version="1.0" encoding="utf-8"?>
<!--
  备份与设备迁移规则：令牌与可信设备都不得离开本机。
  应用已设 allowBackup=false，这里再显式排除一次，避免将来误开备份把凭证带走。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
