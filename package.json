{
  "name": "custodysim",
  "version": "1.5.2-test",
  "private": true,
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "node scripts/clean.mjs --guard",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:realtime": "node --env-file=.env.local realtime-server.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:apply": "node scripts/clean.mjs --apply",
    "build": "pnpm typecheck && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:safety",
    "test:safety": "node scripts/test-clean-guard.mjs && node scripts/test-realtime-flow.mjs && node scripts/test-deploy-flow.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:scoring": "vitest run --config vitest.scoring-e2e.config.mts && playwright test --config playwright.scoring.config.ts",
    "test:e2e:business": "vitest run --config vitest.business-e2e.config.mts",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm test:e2e:scoring && pnpm test:e2e:business && pnpm test:e2e:production",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed-scoreboard-demo": "tsx --env-file=.env.local scripts/seed-scoreboard-demo.ts",
    "db:setup-e2e": "node scripts/setup-e2e-database.mjs",
    "db:bootstrap-admin": "tsx --env-file=.env.local scripts/bootstrap-admin.ts",
    "db:ensure-entry-form": "tsx --env-file=.env.local scripts/ensure-entry-registration-form.ts",
    "db:reconcile-profile-record-sequence": "tsx --env-file=.env.local scripts/reconcile-profile-record-sequence.ts",
    "chat:cleanup": "tsx --env-file=.env.local scripts/cleanup-chat.ts",
    "notices:cleanup": "tsx --env-file=.env.local scripts/cleanup-notices.ts",
    "audit-logs:cleanup": "tsx --env-file=.env.local scripts/cleanup-audit-logs.ts",
    "geoip:update": "tsx --env-file=.env.local scripts/update-geoip.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "geoip-lite": "^2.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.22.0",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tencentcloud-sdk-nodejs-ses": "^4.1.271",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
